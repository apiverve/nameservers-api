            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "nameservers",
        "nameservers api",
        "dns nameservers",
        "domain nameservers",
        "ns lookup",
        "ns records"
    ],
    "homepage": "https://apiverve.com/marketplace/nameservers?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/nameservers",
        "source": "https://github.com/apiverve/nameservers-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Nameservers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Nameservers\\Tests\\": "tests/"
        }
    },
